bool EnsureConnection() {
   if(socket_handle == INVALID_HANDLE || !SocketIsConnected(socket_handle)) {
      if(socket_handle != INVALID_HANDLE) SocketClose(socket_handle);
      socket_handle = SocketCreate();
      
      if(SocketConnect(socket_handle, "127.0.0.1", 9090, 500)) {
         // 1. Send Calibration Time (Header 254)
         uchar header[1] = {254};
         long current_broker_time = TimeCurrent();
         uchar payload[8]; 
         for(int i=0; i<8; i++) payload[i] = (uchar)((current_broker_time >> (i*8)) & 0xFF);
         SocketSend(socket_handle, header, 1);
         SocketSend(socket_handle, payload, 8);
         
         // 2. Send Session Info for all existing subscriptions (Header 3)
         for(int i=0; i<ArraySize(Subscriptions); i++) {
            SendSessionUpdate(Subscriptions[i].symbol);
         }

         Print("📡 Reconnected & Calibrated.");
         return true;
      }
      return false;
   }
   return true;
}

// --- The Session Logic ---
void SendSessionUpdate(string symbol) {
   MqlDateTime dt;
   TimeCurrent(dt);
   ENUM_DAY_OF_WEEK day = (ENUM_DAY_OF_WEEK)dt.day_of_week;
   
   datetime start, end;
   SessionPacket packet;
   ZeroMemory(packet);
   StringToCharArray(symbol, packet.asset, 0, 16);
   
   // We look for the first session (index 0). 
   // If your broker has multiple sessions (e.g. break for lunch), 
   // index 0 usually gives the start and index N gives the final close.
   if(SymbolInfoSessionQuote(symbol, day, 0, start, end)) {
      MqlDateTime start_dt, end_dt;
      TimeToStruct(start, start_dt);
      
      // For the close, we check if there's a second session to get the REAL end of day
      datetime start_tmp, end_final;
      if(SymbolInfoSessionQuote(symbol, day, 1, start_tmp, end_final)) {
         TimeToStruct(end_final, end_dt);
      } else {
         TimeToStruct(end, end_dt);
      }
      
      packet.open_hour = (uint)start_dt.hour;
      packet.open_min  = (uint)start_dt.min;
      packet.close_hour = (uint)end_dt.hour;
      packet.close_min  = (uint)end_dt.min;
      packet.is_active = 1;
   } else {
      packet.is_active = 0; // Market is closed today (Weekend/Holiday)
   }
   
   // Send Header 3 + Packet
   uchar header[1] = {3};
   SocketSend(socket_handle, header, 1);
   
   uchar raw_packet[];
   StructToCharArray(packet, raw_packet);
   SocketSend(socket_handle, raw_packet, sizeof(SessionPacket));
}