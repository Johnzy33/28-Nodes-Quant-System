

# ======================================================================
# CORE ENVIRONMENT SETTINGS
# ======================================================================

# Kafka Brokers - Shared by both Producer and Consumer
KAFKA_BROKERS="127.0.0.1:9092"

# TimescaleDB / PostgreSQL Connection String
# NOTE: Uses the 'standard' connection format used by tokio-postgres
DATABASE_URL="host=localhost user=root password=root dbname=timeseries port=5432"


# ======================================================================
# INGESTION ASSET SETTINGS (These drive the Producer and Consumer)
# ======================================================================

# 1. ASSET METADATA (Used by Producer for Asset ID construction)
ASSET_SYMBOL="US2000"
DATA_SOURCE_ID="FundedNext" 

# 2. PRODUCER FILE PATH
# The full, absolute or relative path to the historical CSV file.
CSV_FILE_PATH="./US2000.csv"

# 3. KAFKA TOPIC (Used by Consumer for subscription)
# The Producer will send to this topic, but we define the full name here for the Consumer.
KAFKA_TOPIC="us2000_market_data, us100_market_data"

# 4. CONSUMER GROUP ID (Used by Consumer)
KAFKA_GROUP_ID="us2000_ingestion_worker_group_final"

# 5. PRODUCER TOPIC BASE (Used by Producer to construct the full topic name)
# This is less critical since we explicitly set KAFKA_TOPIC above, but good practice
# to define the base for consistency with other parts of the system.
KAFKA_TOPIC_BASE="ingestion_worker_group_us2000_v2"