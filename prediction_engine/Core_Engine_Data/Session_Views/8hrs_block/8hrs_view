
DROP TABLE block_base;
CREATE TABLE block_base (
    -- Unique Identifier (Composite Primary Key)
    trading_date DATE NOT NULL,
    asset_id TEXT NOT NULL,
    block_number SMALLINT NOT NULL, -- 1, 2, or 3
    -- OHLC and Metadata
    start_ts TIMESTAMP WITH TIME ZONE NOT NULL,
    end_ts TIMESTAMP WITH TIME ZONE NOT NULL,
    open NUMERIC(16, 8) NOT NULL,
    high NUMERIC(16, 8) NOT NULL,
    low NUMERIC(16, 8) NOT NULL,
    close NUMERIC(16, 8) NOT NULL,
    volume BIGINT NOT NULL,
    bars INTEGER NOT NULL,
    -- Classification
    block_type TEXT NOT NULL,         -- Corresponds to MarketType
    --consolidation_subtype TEXT NOT NULL, -- Corresponds to MarketSubtype
    -- Constraints
    CONSTRAINT pk_block_base PRIMARY KEY (trading_date, asset_id, block_number)
);

SELECT create_hypertable('block_base', 'trading_date', if_not_exists => TRUE);



