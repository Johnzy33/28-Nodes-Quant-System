
DROP MATERIALIZED VIEW IF EXISTS eight_hr_base;
CREATE MATERIALIZED VIEW eight_hr_base AS
WITH base AS (
  SELECT
    time, asset_id, open, high, low, close, volume,
    public.get_trading_day(time) AS trading_date,      -- Uses your custom day definition
    public.custom_8hr_group(time) AS block_number      -- Uses the new 8hr block function
  FROM market_data
)
SELECT
    p.trading_date,
    p.asset_id,
    p.block_number,
    MIN(p.time) AS start_ts,
    MAX(p.time) AS end_ts,
    (array_agg(p.open ORDER BY p.time ASC))[1] AS open,
    MAX(p.high) AS high,
    (array_agg(p.time ORDER BY p.high DESC, p.time ASC))[1] AS high_ts,
    MIN(p.low) AS low,
    (array_agg(p.time ORDER BY p.low ASC, p.time ASC))[1] AS low_ts,
    (array_agg(p.close ORDER BY p.time DESC))[1] AS close,
    SUM(p.volume) AS volume,
    COUNT(*) AS bars
FROM base p
GROUP BY p.trading_date, p.asset_id, p.block_number
-- Use a composite primary key index for fast lookups
WITH DATA;


DROP TABLE block_context;
CREATE TABLE block_context (
    -- --- Keys & Identification ---
    trading_date DATE NOT NULL,
    asset_id TEXT NOT NULL,
    -- Current Block (CB) - Used in the Unique Constraint
    cb_num INTEGER NOT NULL,
    cb_bias TEXT NOT NULL, -- Assuming the bias is always present for the current row
    -- --- Metadata ---
    session_end_ts TIMESTAMPTZ NOT NULL, -- The end time of the current block (CB)
    -- --- Preceding Block 1 (PB1) - LAG(1) ---
    pb1_num INTEGER,                 -- Nullable if no prior block exists (e.g., first entry for an asset)
    pb1_bias TEXT,            -- Nullable
    -- --- Preceding Block 2 (PB2) - LAG(2) ---
    pb2_num INTEGER,                 -- Nullable
    pb2_bias TEXT,            -- Nullable
    -- --- Constraints ---
    -- Defines the unique row identity, used for upserts (INSERT...ON CONFLICT)
    CONSTRAINT pk_block_context PRIMARY KEY (trading_date, asset_id, cb_num)
);

-- Index for efficient time-series lookups
CREATE INDEX idx_block_context_asset_ts ON block_context (asset_id, session_end_ts DESC);